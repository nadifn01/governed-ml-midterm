{
  "model_version": "v3",
  "author": "Farha Nadine",
  "description": "Logistic regression leveraging behavioral telematics across velocity, trend, extremes, and frequency while avoiding geographic proxy traps.",
  "model_type": "logistic_regression",
  "params": {
    "C": 1.0,
    "max_iter": 500
  },
  "features": [
    "years_licensed",
    "vehicle_age",
    "vehicle_value",
    "annual_mileage_declared",
    "prior_insurer_years",
    "prior_claims_3y",
    "speeding_velocity",
    "hard_brake_trend",
    "max_hard_brakes_per_1k",
    "claims_per_month"
  ],
  "decision_threshold": 0.50
}
